# Local only. This file is safe to commit because it contains no user path.
# Copy it to .env and replace the placeholder when the standard save location
# is not appropriate for this Windows account.
EU5_SAVE_DIRECTORY=
EU5_ENABLE_WINDOWS_EXECUTION=false
# Optional absolute path to uvx.exe when `uvx` is not on PATH.
EU5_WINDOWS_MCP_COMMAND=
