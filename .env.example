# Local only. This file is safe to commit because it contains no user path.
# Copy it to .env and replace the placeholder when the standard save location
# is not appropriate for this Windows account.
EU5_SAVE_DIRECTORY=

# Optional local EU5 user-data root. Defaults to:
# Documents/Paradox Interactive/Europa Universalis V
# Used only by eu5_list_debug_exports to inventory metadata for generated
# debug-console exports; it never reads their contents.
EU5_USER_DIRECTORY=
